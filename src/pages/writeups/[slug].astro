---
import { getCollection } from 'astro:content';
import WriteupLayout from '../../layouts/WriteupLayout.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<WriteupLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  category={entry.data.category}
  platform={entry.data.platform}
  difficulty={entry.data.difficulty}
  tags={entry.data.tags}
  artifacts={entry.data.artifacts}
  mitreAttck={entry.data.mitreAttck}
  verdict={entry.data.verdict}
  flag={entry.data.flag}
>
  <Content />
</WriteupLayout>
