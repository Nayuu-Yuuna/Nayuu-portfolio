---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WriteupCard from '../../components/WriteupCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  const validCategories = [
    'DFIR',
    'Memory Forensics',
    'Network Forensics',
    'Threat Hunting',
    'Malware Analysis',
    'SOC Labs',
    'CTF Challenge',
    'Active Directory Defense'
  ];

  return validCategories.map((cat) => {
    const slug = cat.toLowerCase().replace(/\s+/g, '-');
    const filteredWriteups = writeups.filter(
      (w) => w.data.category.toLowerCase() === cat.toLowerCase()
    );
    return {
      params: { category: slug },
      props: { categoryName: cat, writeups: filteredWriteups },
    };
  });
}

const { categoryName, writeups } = Astro.props;
---

<BaseLayout 
  title={`${categoryName} Reports & Labs`} 
  description={`List of all ${categoryName} writeups and investigation case studies.`}
>
  <div class="mb-8">
    <a href="/categories" class="inline-flex items-center text-sm font-mono text-cyber-muted hover:text-cyber-cyan mb-4 transition-colors">
      &lt; Back to all domains
    </a>
    <div class="flex items-center space-x-2 text-cyber-cyan font-mono text-sm mb-2">
      <span>//</span>
      <span>DEFENSE SPECIALIZATION</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-mono font-bold text-cyber-text">
      {categoryName} Reports
    </h1>
    <p class="text-cyber-muted mt-2 text-sm sm:text-base">
      Found {writeups.length} {writeups.length === 1 ? 'case study' : 'case studies'} in this specialization.
    </p>
  </div>

  {writeups.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {writeups.map((post) => (
        <WriteupCard
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          publishDate={post.data.publishDate}
          category={post.data.category}
          platform={post.data.platform}
          difficulty={post.data.difficulty}
          tags={post.data.tags}
          verdict={post.data.verdict}
        />
      ))}
    </div>
  ) : (
    <div class="p-8 rounded-xl bg-cyber-card border border-cyber-border text-center font-mono text-cyber-muted">
      No writeups published under this category yet. Add your investigation report to see it here!
    </div>
  )}
</BaseLayout>
