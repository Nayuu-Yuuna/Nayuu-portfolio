---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WriteupCard from '../../components/WriteupCard.astro';
import { getUrl } from '../../utils/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  const validCategories = [
    'DFIR',
    'Memory Forensics',
    'Network Forensics',
    'Threat Hunting',
    'Malware Analysis',
    'SOC Labs',
    'CTF Challenge',
    'Active Directory Defense'
  ];

  return validCategories.map((cat) => {
    const slug = cat.toLowerCase().replace(/\s+/g, '-');
    const filteredWriteups = writeups.filter(
      (w) => w.data.category.toLowerCase() === cat.toLowerCase()
    );
    return {
      params: { category: slug },
      props: { categoryName: cat, writeups: filteredWriteups },
    };
  });
}

const { categoryName, writeups } = Astro.props;
---

<BaseLayout 
  title={`${categoryName} Reports`} 
  description={`List of all ${categoryName} writeups and investigation case studies.`}
>
  <div class="mb-8">
    <a href={getUrl('/categories')} class="inline-flex items-center text-sm text-chill-muted hover:text-chill-indigo mb-4 transition-colors group">
      <svg class="w-4 h-4 mr-1.5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to all domains
    </a>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-chill-text tracking-tight">
      {categoryName}
    </h1>
    <p class="text-chill-muted mt-2 text-sm sm:text-base">
      Found {writeups.length} {writeups.length === 1 ? 'case study' : 'case studies'} in this domain.
    </p>
  </div>

  {writeups.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {writeups.map((post) => (
        <WriteupCard
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          publishDate={post.data.publishDate}
          category={post.data.category}
          platform={post.data.platform}
          difficulty={post.data.difficulty}
          tags={post.data.tags}
          verdict={post.data.verdict}
        />
      ))}
    </div>
  ) : (
    <div class="p-8 rounded-2xl glass-card text-center text-chill-muted text-sm">
      No writeups published under this category yet.
    </div>
  )}
</BaseLayout>
