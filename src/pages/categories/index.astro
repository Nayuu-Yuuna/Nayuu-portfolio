---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUrl } from '../../utils/url';
import { getCollection } from 'astro:content';

const writeups = await getCollection('writeups');

const categoriesInfo = [
  {
    name: 'DFIR',
    slug: 'dfir',
    title: 'Digital Forensics & Incident Response',
    desc: 'Incident triage, timeline reconstruction, disk imaging, and forensic analysis (Autopsy, KAPE, FTK).',
    icon: '🔍',
  },
  {
    name: 'Memory Forensics',
    slug: 'memory-forensics',
    title: 'Memory Forensics',
    desc: 'Deep volatile RAM analysis with Volatility 3, detecting code injection, rootkits, and extracting C2 configs.',
    icon: '🧠',
  },
  {
    name: 'Network Forensics',
    slug: 'network-forensics',
    title: 'Network Forensics & PCAP',
    desc: 'Packet inspection with Wireshark, Zeek logs, Suricata alerts, DNS tunneling, and C2 beacon detection.',
    icon: '🌐',
  },
  {
    name: 'Threat Hunting',
    slug: 'threat-hunting',
    title: 'Threat Hunting & SIEM',
    desc: 'Hypothesis-based hunting across Windows Event Logs, Sysmon, Splunk SPL queries, and Elastic ELK.',
    icon: '🎯',
  },
  {
    name: 'Malware Analysis',
    slug: 'malware-analysis',
    title: 'Malware Analysis & Triage',
    desc: 'Static/Dynamic triage, YARA signature creation, decompilation in Ghidra, and sandbox execution.',
    icon: '☣️',
  },
  {
    name: 'SOC Labs',
    slug: 'soc-labs',
    title: 'SOC & Defense Labs',
    desc: 'Hands-on alert triage from CyberDefenders, LetsDefend, and TryHackMe SOC Analyst paths.',
    icon: '🛡️',
  },
  {
    name: 'CTF Challenge',
    slug: 'ctf-challenge',
    title: 'CTF Forensics & Reversing',
    desc: 'Jeopardy-style CTF writeups focusing on forensics, stegano, pcap challenges, and reverse engineering.',
    icon: '🚩',
  },
  {
    name: 'Active Directory Defense',
    slug: 'active-directory-defense',
    title: 'Active Directory Defense',
    desc: 'Detecting Kerberoasting, AS-REP Roasting, DCSync, BloodHound graph paths, and hardening AD.',
    icon: '🏛️',
  },
];

const categoryCounts = categoriesInfo.map((cat) => {
  const count = writeups.filter((w) => {
    const slug = w.data.category.toLowerCase().replace(/\s+/g, '-');
    return slug === cat.slug;
  }).length;
  return { ...cat, count };
});
---

<BaseLayout 
  title="Defense Domains" 
  description="Explore writeups categorized by Blue Team and CTF domains."
>
  <div class="mb-10 space-y-2">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-chill-indigo/10 text-chill-indigo text-xs font-medium">
      Specializations
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-chill-text tracking-tight">
      Browse by Domain
    </h1>
    <p class="text-chill-muted text-sm sm:text-base max-w-2xl leading-relaxed">
      Explore investigation walkthroughs, lab reports, and writeups grouped by technical disciplines.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {categoryCounts.map((cat) => (
      <a 
        href={getUrl(`/categories/${cat.slug}`)}
        class="glass-card p-6 rounded-2xl block group relative"
      >
        <div class="flex items-start justify-between mb-4">
          <span class="text-3xl">{cat.icon}</span>
          <span class="text-xs px-2.5 py-1 rounded-full bg-chill-surface border border-white/5 text-chill-indigo font-medium font-mono">
            {cat.count} {cat.count === 1 ? 'report' : 'reports'}
          </span>
        </div>

        <h3 class="text-base font-bold text-chill-text group-hover:text-chill-indigo transition-colors mb-2">
          {cat.title}
        </h3>

        <p class="text-xs text-chill-muted leading-relaxed mb-4 font-sans">
          {cat.desc}
        </p>

        <div class="text-xs text-chill-sky flex items-center gap-1 font-medium group-hover:translate-x-1 transition-transform">
          View case studies &rarr;
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
