---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const writeups = await getCollection('writeups');

const categoriesInfo = [
  {
    name: 'DFIR',
    slug: 'dfir',
    title: 'Digital Forensics & Incident Response',
    desc: 'Incident triage, timeline reconstruction, disk imaging, and forensic analysis (Autopsy, KAPE, FTK).',
    icon: '🔍',
    color: 'text-blue-400 border-blue-500/30',
  },
  {
    name: 'Memory Forensics',
    slug: 'memory-forensics',
    title: 'Memory Forensics',
    desc: 'Deep volatile RAM analysis with Volatility 3, detecting code injection, rootkits, and extracting C2 configs.',
    icon: '🧠',
    color: 'text-purple-400 border-purple-500/30',
  },
  {
    name: 'Network Forensics',
    slug: 'network-forensics',
    title: 'Network Forensics & PCAP',
    desc: 'Packet inspection with Wireshark, Zeek logs, Suricata alerts, DNS tunneling, and C2 beacon detection.',
    icon: '🌐',
    color: 'text-cyber-cyan border-cyber-cyan/30',
  },
  {
    name: 'Threat Hunting',
    slug: 'threat-hunting',
    title: 'Threat Hunting & SIEM',
    desc: 'Hypothesis-based hunting across Windows Event Logs, Sysmon, Splunk SPL queries, and Elastic ELK.',
    icon: '🎯',
    color: 'text-cyber-accent border-cyber-accent/30',
  },
  {
    name: 'Malware Analysis',
    slug: 'malware-analysis',
    title: 'Malware Analysis & Triage',
    desc: 'Static/Dynamic triage, YARA signature creation, decompilation in Ghidra, and sandbox execution.',
    icon: '☣️',
    color: 'text-cyber-red border-cyber-red/30',
  },
  {
    name: 'SOC Labs',
    slug: 'soc-labs',
    title: 'SOC & Defense Labs',
    desc: 'Hands-on alert triage from CyberDefenders, LetsDefend, and TryHackMe SOC Analyst paths.',
    icon: '🛡️',
    color: 'text-amber-400 border-amber-500/30',
  },
  {
    name: 'CTF Challenge',
    slug: 'ctf-challenge',
    title: 'CTF Forensics & Reversing',
    desc: 'Jeopardy-style CTF writeups focusing on forensics, stegano, pcap challenges, and reverse engineering.',
    icon: '🚩',
    color: 'text-sky-400 border-sky-500/30',
  },
  {
    name: 'Active Directory Defense',
    slug: 'active-directory-defense',
    title: 'Active Directory Defense',
    desc: 'Detecting Kerberoasting, AS-REP Roasting, DCSync, BloodHound graph paths, and hardening AD.',
    icon: '🏛️',
    color: 'text-orange-400 border-orange-500/30',
  },
];

const categoryCounts = categoriesInfo.map((cat) => {
  const count = writeups.filter((w) => {
    const slug = w.data.category.toLowerCase().replace(/\s+/g, '-');
    return slug === cat.slug;
  }).length;
  return { ...cat, count };
});
---

<BaseLayout 
  title="Defense Domains & Categories" 
  description="Explore writeups categorized by Blue Team and CTF domains."
>
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-cyber-cyan font-mono text-sm mb-2">
      <span>//</span>
      <span>DEFENSE &amp; INVESTIGATION DOMAINS</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-mono font-bold text-cyber-text">
      Browse by Domain
    </h1>
    <p class="text-cyber-muted mt-2 max-w-2xl text-sm sm:text-base">
      Select a cybersecurity discipline to view associated investigation reports, lab walkthroughs, and artifacts.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {categoryCounts.map((cat) => (
      <a 
        href={`/categories/${cat.slug}`}
        class="group p-6 rounded-2xl bg-cyber-card/85 border border-cyber-border hover:border-cyber-cyan/50 transition-all duration-200 hover:-translate-y-1 block"
      >
        <div class="flex items-start justify-between mb-4">
          <span class="text-3xl">{cat.icon}</span>
          <span class="font-mono text-xs px-2.5 py-1 rounded-full bg-cyber-surface border border-cyber-border text-cyber-cyan">
            {cat.count} {cat.count === 1 ? 'report' : 'reports'}
          </span>
        </div>

        <h3 class="font-mono text-lg font-bold text-cyber-text group-hover:text-cyber-cyan transition-colors mb-2">
          {cat.title}
        </h3>

        <p class="text-sm text-cyber-muted leading-relaxed mb-4">
          {cat.desc}
        </p>

        <div class="font-mono text-xs text-cyber-accent flex items-center group-hover:translate-x-1 transition-transform">
          Explore investigations in {cat.name} &rarr;
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
