---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCard from '../components/StatCard.astro';
import WriteupCard from '../components/WriteupCard.astro';
import { getUrl } from '../utils/url';
import { getCollection } from 'astro:content';

const allWriteups = await getCollection('writeups');
const sortedWriteups = allWriteups.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredWriteups = sortedWriteups.filter(w => w.data.featured).slice(0, 3);
const latestWriteups = sortedWriteups.slice(0, 6);
---

<BaseLayout 
  title="Home" 
  description="Blue Team DFIR Portfolio, CyberDefenders Labs, HTB Sherlocks & CTF Writeups by Nayuu."
>
  <div class="space-y-16 sm:space-y-20">
    <!-- Hero Section: Chill Lofi / Modern Aesthetic -->
    <section class="pt-6 sm:pt-12">
      <div class="p-8 sm:p-12 rounded-3xl glass-card relative overflow-hidden border border-white/10 shadow-2xl">
        <!-- Ambient decorative glow -->
        <div class="absolute -right-16 -top-16 w-72 h-72 bg-chill-indigo/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 w-72 h-72 bg-chill-sky/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-chill-indigo/10 border border-chill-indigo/20 text-chill-indigo text-xs font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-chill-mint animate-pulse"></span>
            Blue Team • DFIR • Threat Hunter
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-chill-text leading-tight">
            Documenting the defense, one lab at a time.
          </h1>

          <p class="text-chill-muted text-base sm:text-lg leading-relaxed font-sans">
            Hey, welcome to my digital garden! I'm <span class="text-chill-text font-semibold">Nayuu</span>. Here you'll find my walkthroughs for <span class="text-chill-sky font-medium">CyberDefenders</span>, <span class="text-chill-mint font-medium">HTB Sherlocks</span>, memory forensics, and CTF challenges.
          </p>

          <!-- Quick tags -->
          <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-chill-surface text-chill-sky border border-white/5">#Volatility3</span>
            <span class="px-2.5 py-1 rounded-lg bg-chill-surface text-chill-indigo border border-white/5">#Wireshark</span>
            <span class="px-2.5 py-1 rounded-lg bg-chill-surface text-chill-mint border border-white/5">#Sysmon</span>
            <span class="px-2.5 py-1 rounded-lg bg-chill-surface text-chill-purple border border-white/5">#PCAP</span>
            <span class="px-2.5 py-1 rounded-lg bg-chill-surface text-chill-rose border border-white/5">#CTF-Forensics</span>
          </div>

          <!-- Action buttons with working base URLs -->
          <div class="pt-4 flex flex-wrap gap-3.5">
            <a 
              href={getUrl('/writeups')} 
              class="px-6 py-3 rounded-full bg-chill-indigo text-slate-950 font-semibold text-sm hover:bg-indigo-300 transition-all shadow-[0_4px_20px_rgba(129,140,248,0.25)] flex items-center gap-2"
            >
              Explore Writeups &amp; Labs
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <a 
              href={getUrl('/cheatsheet')} 
              class="px-6 py-3 rounded-full bg-chill-surface border border-white/10 text-chill-text font-medium text-sm hover:border-chill-indigo/40 hover:text-chill-indigo transition-all"
            >
              DFIR Cheatsheet
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Grid -->
    <section>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <StatCard label="CyberDefenders" value="35+" detail="Memory & PCAP Labs" color="indigo" />
        <StatCard label="HTB Sherlocks" value="15+" detail="Incident Investigations" color="sky" />
        <StatCard label="THM SOC Track" value="Top 3%" detail="Threat Hunting & Splunk" color="purple" />
        <StatCard label="CTF Challenges" value="120+" detail="Forensics, Rev, Stego" color="mint" />
      </div>
    </section>

    <!-- Featured Investigations -->
    {featuredWriteups.length > 0 && (
      <section class="space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-chill-indigo mb-1">
              Highlights
            </div>
            <h2 class="text-2xl font-bold text-chill-text">
              Featured Case Studies
            </h2>
          </div>
          <a href={getUrl('/writeups')} class="text-xs font-medium text-chill-indigo hover:text-chill-sky flex items-center gap-1 transition-colors">
            View all ({allWriteups.length}) &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredWriteups.map((post) => (
            <WriteupCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              publishDate={post.data.publishDate}
              category={post.data.category}
              platform={post.data.platform}
              difficulty={post.data.difficulty}
              tags={post.data.tags}
              verdict={post.data.verdict}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Latest Writeups -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-chill-sky mb-1">
            Recent Activity
          </div>
          <h2 class="text-2xl font-bold text-chill-text">
            Latest Labs &amp; CTF Writeups
          </h2>
        </div>
        <a href={getUrl('/writeups')} class="text-xs font-medium text-chill-sky hover:underline flex items-center gap-1">
          Browse archive &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestWriteups.map((post) => (
          <WriteupCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            publishDate={post.data.publishDate}
            category={post.data.category}
            platform={post.data.platform}
            difficulty={post.data.difficulty}
            tags={post.data.tags}
            verdict={post.data.verdict}
          />
        ))}
      </div>
    </section>

    <!-- Callout / Invite -->
    <section class="p-8 sm:p-10 rounded-3xl glass-card text-center space-y-4 border border-white/5">
      <h3 class="text-xl sm:text-2xl font-bold text-chill-text">
        Writing a new writeup?
      </h3>
      <p class="text-sm text-chill-muted max-w-lg mx-auto font-sans leading-relaxed">
        Just drop your analysis in <code class="text-chill-indigo px-1.5 py-0.5 rounded bg-chill-surface border border-white/5 font-mono">src/content/writeups/</code> and it will be indexed automatically!
      </p>
      <div class="pt-2">
        <a href={getUrl('/about')} class="inline-flex items-center px-5 py-2.5 rounded-full bg-chill-surface border border-chill-indigo/30 text-chill-indigo text-xs font-semibold hover:bg-chill-indigo hover:text-slate-950 transition-all">
          More About My Research &rarr;
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
