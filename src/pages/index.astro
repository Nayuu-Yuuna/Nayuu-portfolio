---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCard from '../components/StatCard.astro';
import WriteupCard from '../components/WriteupCard.astro';
import { getCollection } from 'astro:content';

const allWriteups = await getCollection('writeups');
const sortedWriteups = allWriteups.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredWriteups = sortedWriteups.filter(w => w.data.featured).slice(0, 3);
const latestWriteups = sortedWriteups.slice(0, 6);
---

<BaseLayout 
  title="Home" 
  description="Blue Team DFIR Portfolio, CyberDefenders Labs, HTB Sherlocks & CTF Writeups."
>
  <div class="space-y-16">
    <!-- Hero Section: Blue Team Terminal Style -->
    <section class="relative pt-4 sm:pt-10">
      <div class="rounded-2xl bg-cyber-card border border-cyber-border shadow-2xl overflow-hidden">
        <!-- Terminal Header -->
        <div class="bg-cyber-surface px-4 py-3 border-b border-cyber-border flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-cyan-500/80"></div>
            <span class="ml-2 font-mono text-xs text-cyber-muted">soc-triage-terminal - zsh</span>
          </div>
          <div class="font-mono text-xs text-cyber-cyan">
            [STATUS: DEFENDING &amp; HUNTING]
          </div>
        </div>

        <!-- Terminal Body -->
        <div class="p-6 sm:p-8 font-mono space-y-4">
          <div class="text-xs sm:text-sm text-cyber-muted flex items-center gap-2">
            <span class="text-cyber-cyan">analyst@defender-station:~$</span>
            <span class="text-cyber-text">cat ./soc_brief.txt</span>
          </div>

          <div class="space-y-2 text-sm sm:text-base text-cyber-text pl-4 border-l-2 border-cyber-cyan/50">
            <p class="font-bold text-xl sm:text-2xl text-cyber-cyan">
              Blue Team Analyst &amp; DFIR Researcher
            </p>
            <p class="text-cyber-muted text-sm leading-relaxed max-w-2xl">
              Specializing in Digital Forensics &amp; Incident Response (DFIR), Memory Analysis (Volatility), 
              Network Traffic Inspection (Wireshark/Zeek), and Threat Hunting across CyberDefenders, HTB Sherlocks, TryHackMe, and competitive CTFs.
            </p>
          </div>

          <div class="text-xs sm:text-sm text-cyber-muted flex items-center gap-2 pt-2">
            <span class="text-cyber-cyan">analyst@defender-station:~$</span>
            <span class="text-cyber-accent">ls -la ./focus_areas/</span>
          </div>

          <div class="flex flex-wrap gap-2 pl-4 text-xs">
            <span class="px-2 py-1 rounded bg-cyber-surface border border-cyber-border text-cyber-cyan">[CyberDefenders]</span>
            <span class="px-2 py-1 rounded bg-cyber-surface border border-cyber-border text-emerald-400">[HTB Sherlocks]</span>
            <span class="px-2 py-1 rounded bg-cyber-surface border border-cyber-border text-purple-400">[Memory Forensics]</span>
            <span class="px-2 py-1 rounded bg-cyber-surface border border-cyber-border text-sky-400">[PCAP Analysis]</span>
            <span class="px-2 py-1 rounded bg-cyber-surface border border-cyber-border text-amber-400">[Threat Hunting]</span>
            <span class="px-2 py-1 rounded bg-cyber-surface border border-cyber-border text-cyber-red">[Malware Triage]</span>
            <span class="px-2 py-1 rounded bg-cyber-surface border border-cyber-border text-cyber-accent">[CTF Writeups]</span>
          </div>

          <div class="pt-4 flex flex-wrap gap-4">
            <a 
              href="/writeups" 
              class="px-5 py-2.5 rounded-xl bg-cyber-cyan text-slate-950 font-mono font-bold text-sm hover:bg-cyan-300 transition-all shadow-[0_0_15px_rgba(0,240,255,0.25)]"
            >
              &gt; View Case Studies &amp; Writeups
            </a>
            <a 
              href="/cheatsheet" 
              class="px-5 py-2.5 rounded-xl bg-cyber-surface border border-cyber-border font-mono text-sm text-cyber-text hover:text-cyber-cyan hover:border-cyber-cyan/40 transition-all"
            >
              DFIR Cheatsheet
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Grid -->
    <section>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <StatCard label="CyberDefenders" value="35+" detail="DFIR & Threat Hunting" color="cyan" />
        <StatCard label="HTB Sherlocks" value="15+" detail="Incident Investigations" color="green" />
        <StatCard label="THM SOC Badges" value="Top 3%" detail="Cyber Defense Tracks" color="purple" />
        <StatCard label="CTF Flags / Forensics" value="120+" detail="PCAP, Memory, Stego, Rev" color="yellow" />
      </div>
    </section>

    <!-- Featured Investigations -->
    {featuredWriteups.length > 0 && (
      <section class="space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center space-x-2 text-cyber-cyan font-mono text-xs mb-1">
              <span>//</span>
              <span>IN-DEPTH CASE STUDIES</span>
            </div>
            <h2 class="text-2xl font-mono font-bold text-cyber-text">
              Featured Investigations
            </h2>
          </div>
          <a href="/writeups" class="font-mono text-xs text-cyber-cyan hover:underline flex items-center gap-1">
            View all ({allWriteups.length}) &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredWriteups.map((post) => (
            <WriteupCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              publishDate={post.data.publishDate}
              category={post.data.category}
              platform={post.data.platform}
              difficulty={post.data.difficulty}
              tags={post.data.tags}
              verdict={post.data.verdict}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Latest Writeups -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <div class="flex items-center space-x-2 text-cyber-accent font-mono text-xs mb-1">
            <span>//</span>
            <span>TIMELINE FEED</span>
          </div>
          <h2 class="text-2xl font-mono font-bold text-cyber-text">
            Recent Labs &amp; CTF Writeups
          </h2>
        </div>
        <a href="/writeups" class="font-mono text-xs text-cyber-cyan hover:underline flex items-center gap-1">
          Filter by platform &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestWriteups.map((post) => (
          <WriteupCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            publishDate={post.data.publishDate}
            category={post.data.category}
            platform={post.data.platform}
            difficulty={post.data.difficulty}
            tags={post.data.tags}
            verdict={post.data.verdict}
          />
        ))}
      </div>
    </section>

    <!-- Quick Callout -->
    <section class="p-8 rounded-2xl bg-gradient-to-r from-cyber-surface to-cyber-card border border-cyber-border text-center space-y-4">
      <h3 class="font-mono text-xl font-bold text-cyber-text">
        Publishing a new lab or challenge writeup?
      </h3>
      <p class="text-sm text-cyber-muted max-w-xl mx-auto font-mono">
        Drop a new <code class="text-cyber-cyan">.md</code> file into <code class="text-cyber-accent">src/content/writeups/</code> with artifacts and MITRE ATT&amp;CK tags. It will be indexed instantly!
      </p>
      <div class="pt-2">
        <a href="/about" class="inline-block px-5 py-2 rounded-lg bg-cyber-surface border border-cyber-cyan text-cyber-cyan font-mono text-xs hover:bg-cyber-cyan hover:text-slate-950 transition-colors">
          About My Blue Team Journey &rarr;
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
