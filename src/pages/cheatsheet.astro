---
import BaseLayout from '../layouts/BaseLayout.astro';

const cheatsheets = [
  {
    category: 'Memory Forensics (Volatility 3)',
    commands: [
      {
        title: 'List Process Tree',
        cmd: 'python3 vol.py -f memory.dmp windows.pstree',
        desc: 'Identify suspicious parent-child process anomalies (e.g. word.exe spawning cmd.exe).'
      },
      {
        title: 'Detect Injected Code & Hollowed Processes',
        cmd: 'python3 vol.py -f memory.dmp windows.malfind',
        desc: 'Find hidden or injected code in user-mode memory (PAGE_EXECUTE_READWRITE memory pages).'
      },
      {
        title: 'Network Connections & Sockets',
        cmd: 'python3 vol.py -f memory.dmp windows.netscan',
        desc: 'Enumerate established TCP/UDP connections and listening sockets active at the time of memory acquisition.'
      },
      {
        title: 'Dump Process Executable & Memory',
        cmd: 'python3 vol.py -f memory.dmp -o ./dump windows.dumpfiles --pid <PID>',
        desc: 'Dump binary artifacts for offline static analysis, Ghidra disassembly, and hashing.'
      },
      {
        title: 'Inspect Command-Line Arguments',
        cmd: 'python3 vol.py -f memory.dmp windows.cmdline',
        desc: 'Review executed command line strings (e.g. encoded PowerShell scripts, certutil downloads).'
      }
    ]
  },
  {
    category: 'Network Forensics (Wireshark & Tshark)',
    commands: [
      {
        title: 'Filter HTTP POST Requests & Uploads',
        cmd: 'http.request.method == "POST" || http.request.method == "PUT"',
        desc: 'Isolate potential web shells, data exfiltration, or C2 beacon callbacks.'
      },
      {
        title: 'Identify Suspicious DNS Queries (Tunneling / DGA)',
        cmd: 'dns.flags.response == 0 && dns.qry.name.len > 30',
        desc: 'Detect possible DNS data exfiltration and long randomly generated subdomains.'
      },
      {
        title: 'Extract Kerberos Ticket Requests (Kerberoasting)',
        cmd: 'kerberos.msg_type == 14 && kerberos.enctype == 23',
        desc: 'Filter RC4-HMAC encrypted TGS-REQ packets indicating Kerberoasting activity.'
      },
      {
        title: 'Tshark Extract HTTP Hostnames & User Agents',
        cmd: 'tshark -r capture.pcap -Y "http.request" -T fields -e ip.src -e ip.dst -e http.host -e http.user_agent | sort | uniq -c',
        desc: 'Fast command-line aggregation of all outbound web traffic and anomalies.'
      }
    ]
  },
  {
    category: 'Windows Event Logs & Sysmon Hunting',
    commands: [
      {
        title: 'Suspicious Process Creation (Event ID 4688 / Sysmon 1)',
        cmd: 'EventID=4688 OR EventID=1 | CommandLine="* -enc *" OR CommandLine="*downloadstring*" OR CommandLine="*certutil*"',
        desc: 'Catch obfuscated Base64 PowerShell execution and malicious payload downloaders.'
      },
      {
        title: 'Service Installation / Persistence (Event ID 7045 / 4697)',
        cmd: 'EventID=7045 | ImagePath="*\\AppData\\*" OR ImagePath="*\\Temp\\*"',
        desc: 'Detect malicious services dropped into user directories or temporary paths.'
      },
      {
        title: 'Remote Thread Injection (Sysmon Event ID 8)',
        cmd: 'EventID=8 SourceImage="*.exe" TargetImage="*\\svchost.exe" OR TargetImage="*\\explorer.exe"',
        desc: 'Detect process injection techniques (e.g. Cobalt Strike Beacon injecting into legitimate Windows processes).'
      },
      {
        title: 'Lateral Movement - Remote Logon (Event ID 4624 Type 3 & 10)',
        cmd: 'EventID=4624 (LogonType=3 OR LogonType=10) AND NOT SourceNetworkAddress="-"',
        desc: 'Track network logons (SMB, WinRM) and Remote Desktop connections across the enterprise.'
      }
    ]
  },
  {
    category: 'DFIR Triage & Evidence Collection',
    commands: [
      {
        title: 'Parse MFT with MFTECmd (Eric Zimmerman)',
        cmd: 'MFTECmd.exe -f C:\\$MFT --csv C:\\out\\ --csvf mft_analysis.csv',
        desc: 'Parse Master File Table to reconstruct timeline of file creation, modification, and deletion.'
      },
      {
        title: 'Inspect Amcache & Shimcache (Application Execution)',
        cmd: 'AmcacheParser.exe -f "C:\\Windows\\appcompat\\Programs\\Amcache.hve" --csv C:\\out\\',
        desc: 'Identify historical binary executions even if malware deleted itself from disk.'
      },
      {
        title: 'Linux Investigation - List Open Sockets with PIDs',
        cmd: 'ss -tulpn | grep -E "ESTAB|LISTEN"',
        desc: 'Fast detection of backdoor listeners and active C2 connections on compromised Linux servers.'
      }
    ]
  }
];
---

<BaseLayout 
  title="Blue Team & DFIR Cheatsheet" 
  description="Quick reference commands for Volatility 3, Wireshark, Sysmon threat hunting, and digital forensics triage."
>
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-cyber-cyan font-mono text-sm mb-2">
      <span>//</span>
      <span>BLUE TEAM &amp; INCIDENT RESPONSE FIELD GUIDE</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-mono font-bold text-cyber-text">
      DFIR &amp; Threat Hunting Cheatsheet
    </h1>
    <p class="text-cyber-muted mt-2 max-w-2xl text-sm sm:text-base">
      High-yield hunting queries, Wireshark filters, Volatility commands, and Windows Event IDs used in CyberDefenders labs, HTB Sherlocks, and live incident triage.
    </p>
  </div>

  <div class="space-y-10">
    {cheatsheets.map((section) => (
      <section class="space-y-4">
        <h2 class="text-xl font-mono font-bold text-cyber-cyan flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-cyber-cyan rounded-sm"></span>
          {section.category}
        </h2>

        <div class="grid grid-cols-1 gap-4">
          {section.commands.map((item) => (
            <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <span class="font-mono text-sm font-semibold text-cyber-text">
                  {item.title}
                </span>
                <span class="text-xs text-cyber-muted font-mono">
                  {item.desc}
                </span>
              </div>

              <div class="relative group">
                <pre class="bg-cyber-surface p-3 pr-24 rounded-lg font-mono text-xs text-cyber-accent overflow-x-auto border border-cyber-border/70 selection:bg-cyber-cyan/30"><code>{item.cmd}</code></pre>
                <button
                  type="button"
                  class="copy-btn absolute right-2 top-2 px-2.5 py-1 rounded bg-cyber-card border border-cyber-border text-xs font-mono text-cyber-muted hover:text-cyber-cyan hover:border-cyber-cyan/50 transition-all"
                  data-clipboard={item.cmd}
                >
                  Copy
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  const copyButtons = document.querySelectorAll('.copy-btn');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-clipboard') || '';
      try {
        await navigator.clipboard.writeText(text);
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('text-cyber-cyan', 'border-cyber-cyan');
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('text-cyber-cyan', 'border-cyber-cyan');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  });
</script>
