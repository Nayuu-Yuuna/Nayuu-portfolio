---
import BaseLayout from './BaseLayout.astro';
import { getUrl } from '../utils/url';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  category: string;
  platform: string;
  difficulty: 'Easy' | 'Medium' | 'Hard' | 'Insane';
  tags: string[];
  artifacts?: string[];
  mitreAttck?: string[];
  verdict?: string;
  flag?: string;
}

const { title, description, publishDate, category, platform, difficulty, tags, artifacts, mitreAttck, verdict, flag } = Astro.props;

const difficultyColors = {
  Easy: 'text-chill-mint bg-chill-mint/10 border-chill-mint/20',
  Medium: 'text-chill-amber bg-chill-amber/10 border-chill-amber/20',
  Hard: 'text-chill-rose bg-chill-rose/10 border-chill-rose/20',
  Insane: 'text-chill-purple bg-chill-purple/10 border-chill-purple/20',
};
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto">
    <!-- Back button -->
    <a href={getUrl('/writeups')} class="inline-flex items-center text-sm text-chill-muted hover:text-chill-indigo mb-6 transition-colors group">
      <svg class="w-4 h-4 mr-1.5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to all writeups
    </a>

    <!-- Header Card -->
    <header class="p-6 sm:p-8 rounded-3xl bg-chill-card/80 border border-white/10 mb-8 shadow-xl backdrop-blur-xl">
      <div class="flex flex-wrap items-center gap-2 mb-4 text-xs">
        <span class="px-3 py-1 rounded-full bg-chill-indigo/10 border border-chill-indigo/20 text-chill-indigo font-medium">
          {category}
        </span>
        <span class="px-3 py-1 rounded-full bg-chill-surface border border-white/5 text-chill-muted">
          {platform}
        </span>
        <span class={`px-3 py-1 rounded-full font-semibold border ${difficultyColors[difficulty]}`}>
          {difficulty}
        </span>
        <span class="text-chill-muted/70 ml-auto">
          {publishDate}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-chill-text tracking-tight mb-3 leading-tight">
        {title}
      </h1>

      <p class="text-chill-muted text-base leading-relaxed mb-6 font-sans">
        {description}
      </p>

      <!-- Blue Team Metadata Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-5 border-t border-white/5 text-xs">
        <!-- Artifacts Analyzed -->
        {artifacts && artifacts.length > 0 && (
          <div class="space-y-1.5">
            <span class="text-chill-sky font-semibold block">📁 Artifacts Analyzed:</span>
            <div class="flex flex-wrap gap-1.5">
              {artifacts.map((art) => (
                <code class="px-2.5 py-0.5 rounded-md bg-chill-surface text-chill-text border border-white/5 font-mono">{art}</code>
              ))}
            </div>
          </div>
        )}

        <!-- MITRE ATT&CK Matrix -->
        {mitreAttck && mitreAttck.length > 0 && (
          <div class="space-y-1.5">
            <span class="text-chill-indigo font-semibold block">🛡️ MITRE ATT&amp;CK TTPs:</span>
            <div class="flex flex-wrap gap-1.5">
              {mitreAttck.map((ttp) => (
                <span class="px-2.5 py-0.5 rounded-md bg-chill-surface text-chill-indigo border border-chill-indigo/20 text-[11px] font-mono">
                  {ttp}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Incident Verdict Banner -->
      {verdict && (
        <div class="mt-5 p-3.5 rounded-xl bg-chill-surface/80 border border-chill-rose/20 flex items-center space-x-2.5 text-xs text-chill-text">
          <span class="w-2 h-2 rounded-full bg-chill-rose animate-pulse"></span>
          <span class="text-chill-rose font-semibold">Incident Verdict:</span>
          <span class="text-chill-sky">{verdict}</span>
        </div>
      )}

      <!-- Spoiler Flag / Solution Banner -->
      {flag && (
        <div class="mt-4 p-3.5 rounded-xl bg-chill-surface/60 border border-chill-mint/20 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
          <div class="flex items-center space-x-2">
            <span class="text-chill-mint font-semibold">🚩 Flag:</span>
            <span 
              id="flag-box" 
              class="cursor-pointer filter blur-[5px] hover:blur-none select-none transition-all duration-200 px-2.5 py-0.5 rounded bg-chill-card text-chill-mint border border-white/10 font-mono"
              title="Click to reveal / hide"
            >
              {flag}
            </span>
          </div>
          <span class="text-[11px] text-chill-muted/60">(Click to reveal / hide)</span>
        </div>
      )}
    </header>

    <!-- Writeup Markdown Body -->
    <article class="markdown-content bg-chill-card/60 p-6 sm:p-10 rounded-3xl border border-white/5 shadow-xl backdrop-blur-md">
      <slot />
    </article>

    <!-- Post footer -->
    <div class="mt-8 pt-6 border-t border-white/5 flex justify-between items-center text-xs text-chill-muted">
      <span>Blue Team / DFIR Case Study</span>
      <a href="#top" class="text-chill-indigo hover:underline">↑ Back to top</a>
    </div>
  </div>
</BaseLayout>

<script>
  const flagBox = document.getElementById('flag-box');
  if (flagBox) {
    flagBox.addEventListener('click', () => {
      flagBox.classList.toggle('blur-[5px]');
    });
  }
</script>
