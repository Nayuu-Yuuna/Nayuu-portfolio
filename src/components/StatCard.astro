---
interface Props {
  label: string;
  value: string;
  detail?: string;
  icon?: string;
  color?: 'green' | 'cyan' | 'purple' | 'yellow';
}

const { label, value, detail, color = 'green' } = Astro.props;

const colorMap = {
  green: 'text-cyber-accent border-cyber-accent/30 bg-cyber-accent/5',
  cyan: 'text-cyber-cyan border-cyber-cyan/30 bg-cyber-cyan/5',
  purple: 'text-purple-400 border-purple-500/30 bg-purple-500/5',
  yellow: 'text-cyber-yellow border-cyber-yellow/30 bg-cyber-yellow/5',
};
---

<div class={`p-4 rounded-xl border ${colorMap[color]} backdrop-blur-sm`}>
  <div class="text-xs font-mono text-cyber-muted uppercase tracking-wider mb-1">
    {label}
  </div>
  <div class="text-2xl sm:text-3xl font-mono font-bold tracking-tight">
    {value}
  </div>
  {detail && (
    <div class="text-xs font-mono text-cyber-muted/80 mt-1">
      {detail}
    </div>
  )}
</div>
