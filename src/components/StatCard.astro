---
interface Props {
  label: string;
  value: string;
  detail?: string;
  color?: 'indigo' | 'sky' | 'purple' | 'mint';
}

const { label, value, detail, color = 'indigo' } = Astro.props;

const colorMap = {
  indigo: 'text-chill-indigo border-chill-indigo/20 bg-chill-indigo/5',
  sky: 'text-chill-sky border-chill-sky/20 bg-chill-sky/5',
  purple: 'text-chill-purple border-chill-purple/20 bg-chill-purple/5',
  mint: 'text-chill-mint border-chill-mint/20 bg-chill-mint/5',
};
---

<div class={`p-5 rounded-2xl border ${colorMap[color]} backdrop-blur-md transition-all hover:scale-[1.02]`}>
  <div class="text-xs text-chill-muted font-medium uppercase tracking-wider mb-1.5">
    {label}
  </div>
  <div class="text-2xl sm:text-3xl font-bold tracking-tight text-chill-text">
    {value}
  </div>
  {detail && (
    <div class="text-xs text-chill-muted/80 mt-1">
      {detail}
    </div>
  )}
</div>
