---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/writeups', label: 'Writeups' },
  { href: '/categories', label: 'Categories' },
  { href: '/cheatsheet', label: 'Cheatsheet' },
  { href: '/about', label: 'About & Certs' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-cyber-bg/85 border-b border-cyber-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Prompt -->
    <a href="/" class="flex items-center space-x-2 group">
      <div class="h-3 w-3 rounded-full bg-cyber-accent animate-pulse shadow-[0_0_8px_#00ff88]"></div>
      <span class="font-mono font-bold text-sm sm:text-base text-cyber-text group-hover:text-cyber-accent transition-colors">
        <span class="text-cyber-accent">sec@ctf-hub</span>:<span class="text-cyber-cyan">~</span>#
      </span>
    </a>

    <!-- Nav Items -->
    <nav class="hidden md:flex items-center space-x-1 font-mono text-sm">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-md transition-all ${
              isActive
                ? 'bg-cyber-surface text-cyber-accent border border-cyber-accent/40 shadow-[0_0_10px_rgba(0,255,136,0.15)]'
                : 'text-cyber-muted hover:text-cyber-text hover:bg-cyber-card/60'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Side Badges / Mobile button -->
    <div class="flex items-center space-x-3">
      <div class="hidden sm:flex items-center px-2.5 py-1 rounded-full bg-cyber-surface border border-cyber-border text-xs font-mono text-cyber-muted">
        <span class="w-2 h-2 rounded-full bg-emerald-400 mr-2 animate-ping"></span>
        <span class="text-cyber-accent font-semibold mr-1">ONLINE</span> | CTF Player
      </div>
      
      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-btn" 
        class="md:hidden p-2 rounded-md bg-cyber-card border border-cyber-border text-cyber-muted hover:text-cyber-accent"
        aria-label="Toggle navigation"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-cyber-border bg-cyber-card/95 px-4 pt-2 pb-4 space-y-1 font-mono text-sm">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-cyber-muted hover:text-cyber-accent hover:bg-cyber-surface transition-colors"
      >
        &gt; {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
