---
import { getUrl } from '../utils/url';

const navItems = [
  { href: getUrl('/'), label: 'Home' },
  { href: getUrl('/writeups'), label: 'Writeups' },
  { href: getUrl('/categories'), label: 'Categories' },
  { href: getUrl('/cheatsheet'), label: 'Cheatsheet' },
  { href: getUrl('/about'), label: 'About & Certs' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-chill-bg/80 border-b border-white/5 transition-all">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href={getUrl('/')} class="flex items-center space-x-2.5 group">
      <div class="h-2.5 w-2.5 rounded-full bg-chill-indigo shadow-[0_0_10px_#818cf8] transition-all group-hover:scale-125"></div>
      <span class="font-mono text-sm sm:text-base font-semibold tracking-tight text-chill-text group-hover:text-chill-indigo transition-colors">
        nayuu<span class="text-chill-indigo">.</span>sec
      </span>
    </a>

    <!-- Nav Items (Desktop) -->
    <nav class="hidden md:flex items-center space-x-1.5 text-sm font-medium">
      {navItems.map((item) => {
        const itemClean = item.href.replace(/\/$/, '') || '/';
        const isActive = currentPath === itemClean || (itemClean !== getUrl('/') && currentPath.startsWith(itemClean));
        return (
          <a
            href={item.href}
            class={`px-3.5 py-1.5 rounded-full transition-all duration-200 ${
              isActive
                ? 'bg-chill-indigo/15 text-chill-indigo border border-chill-indigo/30 font-semibold'
                : 'text-chill-muted hover:text-chill-text hover:bg-white/5'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Side Badges / Mobile button -->
    <div class="flex items-center space-x-3">
      <div class="hidden sm:flex items-center px-3 py-1 rounded-full bg-chill-surface/80 border border-white/5 text-xs text-chill-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-chill-mint mr-2 animate-pulse"></span>
        <span class="text-chill-text font-medium">DFIR &amp; CTF</span>
      </div>
      
      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-btn" 
        class="md:hidden p-2 rounded-lg bg-chill-card border border-white/10 text-chill-muted hover:text-chill-text focus:outline-none"
        aria-label="Toggle navigation"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-white/10 bg-chill-card/95 backdrop-blur-xl px-4 pt-2 pb-4 space-y-1 text-sm font-medium">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-lg text-chill-muted hover:text-chill-indigo hover:bg-chill-surface transition-colors"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
