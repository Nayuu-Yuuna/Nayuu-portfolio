---
import { getUrl } from '../utils/url';

interface Props {
  title: string;
  description: string;
  slug: string;
  publishDate: string;
  category: string;
  platform: string;
  difficulty: 'Easy' | 'Medium' | 'Hard' | 'Insane';
  tags: string[];
  verdict?: string;
}

const { title, description, slug, publishDate, category, platform, difficulty, tags, verdict } = Astro.props;

const difficultyColors = {
  Easy: 'text-chill-mint bg-chill-mint/10 border-chill-mint/20',
  Medium: 'text-chill-amber bg-chill-amber/10 border-chill-amber/20',
  Hard: 'text-chill-rose bg-chill-rose/10 border-chill-rose/20',
  Insane: 'text-chill-purple bg-chill-purple/10 border-chill-purple/20',
};

const categoryColors: Record<string, string> = {
  DFIR: 'text-chill-sky border-chill-sky/20 bg-chill-sky/10',
  'Memory Forensics': 'text-chill-purple border-chill-purple/20 bg-chill-purple/10',
  'Network Forensics': 'text-chill-indigo border-chill-indigo/20 bg-chill-indigo/10',
  'Threat Hunting': 'text-chill-mint border-chill-mint/20 bg-chill-mint/10',
  'Malware Analysis': 'text-chill-rose border-chill-rose/20 bg-chill-rose/10',
  'SOC Labs': 'text-chill-amber border-chill-amber/20 bg-chill-amber/10',
  'CTF Challenge': 'text-chill-sky border-chill-sky/20 bg-chill-sky/10',
  'Active Directory Defense': 'text-orange-400 border-orange-500/20 bg-orange-500/10',
};
---

<article class="glass-card rounded-2xl p-6 flex flex-col justify-between group relative">
  <div>
    <!-- Header Badges -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5">
      <div class="flex items-center gap-1.5">
        <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium border ${categoryColors[category] || 'text-chill-muted border-white/10'}`}>
          {category}
        </span>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-chill-surface/80 border border-white/5 text-chill-muted">
          {platform}
        </span>
      </div>

      <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${difficultyColors[difficulty]}`}>
        {difficulty}
      </span>
    </div>

    <!-- Title & Description -->
    <h3 class="text-base sm:text-lg font-bold text-chill-text group-hover:text-chill-indigo transition-colors mb-2 leading-snug">
      <a href={getUrl(`/writeups/${slug}`)} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <p class="text-sm text-chill-muted line-clamp-2 mb-4 leading-relaxed font-sans">
      {description}
    </p>

    {verdict && (
      <div class="mb-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-chill-surface/60 border border-white/5 text-xs text-chill-sky">
        <span class="w-1.5 h-1.5 rounded-full bg-chill-rose"></span>
        <span class="text-chill-muted">Verdict:</span> {verdict}
      </div>
    )}
  </div>

  <!-- Footer Info & Tags -->
  <div class="pt-3.5 border-t border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-chill-muted">
    <div class="flex flex-wrap gap-1.5 font-mono">
      {tags.slice(0, 3).map((tag) => (
        <span class="text-[11px] text-chill-muted/80 bg-chill-surface/90 px-2 py-0.5 rounded-md border border-white/5">
          #{tag}
        </span>
      ))}
      {tags.length > 3 && (
        <span class="text-[11px] text-chill-muted/60 self-center">+{tags.length - 3}</span>
      )}
    </div>

    <div class="flex items-center justify-between sm:justify-end gap-2 text-chill-muted/70 text-xs">
      <span>{publishDate}</span>
      <svg class="w-3.5 h-3.5 text-chill-indigo group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </div>
  </div>
</article>
