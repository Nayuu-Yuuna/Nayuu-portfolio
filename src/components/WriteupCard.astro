---
interface Props {
  title: string;
  description: string;
  slug: string;
  publishDate: string;
  category: string;
  platform: string;
  difficulty: 'Easy' | 'Medium' | 'Hard' | 'Insane';
  tags: string[];
  verdict?: string;
}

const { title, description, slug, publishDate, category, platform, difficulty, tags, verdict } = Astro.props;

const difficultyColors = {
  Easy: 'text-emerald-400 bg-emerald-950/40 border-emerald-500/30',
  Medium: 'text-amber-400 bg-amber-950/40 border-amber-500/30',
  Hard: 'text-rose-400 bg-rose-950/40 border-rose-500/30',
  Insane: 'text-purple-400 bg-purple-950/40 border-purple-500/30',
};

const categoryColors: Record<string, string> = {
  DFIR: 'text-blue-400 border-blue-500/30 bg-blue-950/20',
  'Memory Forensics': 'text-purple-400 border-purple-500/30 bg-purple-950/20',
  'Network Forensics': 'text-cyber-cyan border-cyber-cyan/30 bg-cyan-950/20',
  'Threat Hunting': 'text-cyber-accent border-cyber-accent/30 bg-emerald-950/20',
  'Malware Analysis': 'text-cyber-red border-cyber-red/30 bg-rose-950/20',
  'SOC Labs': 'text-amber-400 border-amber-500/30 bg-amber-950/20',
  'CTF Challenge': 'text-sky-400 border-sky-500/30 bg-sky-950/20',
  'Active Directory Defense': 'text-orange-400 border-orange-500/30 bg-orange-950/20',
};

const platformBadges: Record<string, string> = {
  CyberDefenders: 'text-sky-400 border-sky-500/40 bg-sky-950/30',
  HackTheBox: 'text-emerald-400 border-emerald-500/40 bg-emerald-950/30',
  TryHackMe: 'text-rose-400 border-rose-500/40 bg-rose-950/30',
  LetsDefend: 'text-indigo-400 border-indigo-500/40 bg-indigo-950/30',
  'CTF Event': 'text-cyber-yellow border-cyber-yellow/40 bg-amber-950/30',
};
---

<article class="group relative rounded-xl bg-cyber-card/85 p-5 cyber-border flex flex-col justify-between transition-all duration-200 hover:-translate-y-1">
  <div>
    <!-- Header Badges -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-1.5">
        <span class={`px-2 py-0.5 rounded text-xs font-mono font-medium border ${categoryColors[category] || 'text-cyber-muted border-cyber-border'}`}>
          {category}
        </span>
        <span class={`text-xs font-mono px-2 py-0.5 rounded border ${platformBadges[platform] || 'bg-cyber-surface text-cyber-muted border-cyber-border'}`}>
          {platform}
        </span>
      </div>

      <span class={`px-2 py-0.5 rounded text-xs font-mono font-semibold border ${difficultyColors[difficulty]}`}>
        {difficulty}
      </span>
    </div>

    <!-- Title & Description -->
    <h3 class="font-mono text-lg font-bold text-cyber-text group-hover:text-cyber-accent transition-colors mb-2">
      <a href={`/writeups/${slug}`} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <p class="text-sm text-cyber-muted line-clamp-2 mb-3 leading-relaxed">
      {description}
    </p>

    {verdict && (
      <div class="mb-3 inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-cyber-surface/90 border border-cyber-border text-[11px] font-mono text-cyber-cyan">
        <span class="text-cyber-red font-bold">●</span> Verdict: {verdict}
      </div>
    )}
  </div>

  <!-- Footer Info & Tags -->
  <div class="pt-3 border-t border-cyber-border/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono text-cyber-muted">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <span class="text-[11px] text-cyber-muted/80 bg-cyber-surface/90 px-1.5 py-0.5 rounded">
          #{tag}
        </span>
      ))}
      {tags.length > 3 && (
        <span class="text-[11px] text-cyber-muted/60 px-1">+{tags.length - 3}</span>
      )}
    </div>

    <div class="flex items-center justify-between sm:justify-end gap-2 text-cyber-muted/70">
      <span>{publishDate}</span>
      <svg class="w-4 h-4 text-cyber-cyan group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </div>
  </div>
</article>
