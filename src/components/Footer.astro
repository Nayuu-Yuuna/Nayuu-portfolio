---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/5 mt-24 bg-chill-bg/60 backdrop-blur-md text-xs text-chill-muted font-sans">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <!-- Left: Logo & motto -->
      <div class="flex items-center space-x-2">
        <span class="font-mono font-bold text-chill-indigo">nayuu.sec</span>
        <span class="text-chill-muted/40">•</span>
        <span>Late night research &amp; CTF notes</span>
      </div>

      <!-- Right: Links -->
      <div class="flex items-center space-x-5 text-chill-muted">
        <a href="https://github.com/Nayuu-Yuuna" target="_blank" rel="noopener noreferrer" class="hover:text-chill-text transition-colors">
          GitHub
        </a>
        <a href="https://cyberdefenders.org" target="_blank" rel="noopener noreferrer" class="hover:text-chill-sky transition-colors">
          CyberDefenders
        </a>
        <a href="https://app.hackthebox.com" target="_blank" rel="noopener noreferrer" class="hover:text-chill-mint transition-colors">
          HackTheBox
        </a>
        <a href="https://tryhackme.com" target="_blank" rel="noopener noreferrer" class="hover:text-chill-rose transition-colors">
          TryHackMe
        </a>
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center text-[11px] text-chill-muted/50 gap-2">
      <p>© {currentYear} Nayuu. All writeups are documented for educational and defensive analysis.</p>
      <p>Built with Astro &amp; Tailwind</p>
    </div>
  </div>
</footer>
